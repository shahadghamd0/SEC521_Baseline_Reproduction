      "source": [
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "\n",
        "locations = ['P1 (3.5 dB)', 'P2 (5.0 dB)', 'P3 (7.0 dB)', 'P4 (9.5 dB)', 'P5 (12.0 dB)']\n",
        "success_rates = [54.2, 71.7, 83.9, 99.2, 100.0]\n",
        "cbr_rates = [45.8, 28.3, 16.1, 0.8, 0.0]\n",
        "\n",
        "x = np.arange(len(locations))\n",
        "width = 0.55\n",
        "\n",
        "plt.figure(figsize=(7, 4))\n",
        "plt.bar(x, success_rates, width, label='Legitimate Connection Success', color='#109618')\n",
        "plt.bar(x, cbr_rates, width, bottom=success_rates, label='Collateral Blocking Rate (CBR)', color='#ff9900')\n",
        "\n",
        "plt.axhline(y=81.8, color='red', linestyle=':', linewidth=1.5, label='Reproduced Mean Success (81.8%)')\n",
        "\n",
        "plt.xticks(x, locations)\n",
        "plt.xlabel('Victim Location (Fingerprint Distance to Attacker in dB)')\n",
        "plt.ylabel('Legitimate Traffic Outcome (%)')\n",
        "plt.title('StormShield Limitation: Collateral Blocking vs. Distance')\n",
        "plt.ylim(0, 115)\n",
        "plt.legend(loc='lower left')\n",
        "plt.grid(axis='y', linestyle='--', alpha=0.5)\n",
        "\n",
        "for i, (s, c) in enumerate(zip(success_rates, cbr_rates)):\n",
        "    plt.text(i, s/2, f'{s:.1f}%', ha='center', va='center', color='white', fontweight='bold')\n",
        "    if c > 5:\n",
        "        plt.text(i, s + c/2, f'{c:.1f}%', ha='center', va='center', color='black', fontweight='bold')\n",
        "\n",
        "plt.show()\n",
        "print(f'Overall Average Collateral Blocking Rate: {np.mean(cbr_rates):.1f}% (StormShield Table 4 reports 17% - 25%)')\n"
      ]
    },
